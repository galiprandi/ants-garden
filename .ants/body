FROM openeuler/opencode

WORKDIR /workspace

# Install GitHub CLI (cached layer)
RUN dnf install -y curl && \
    curl -fsSL https://github.com/cli/cli/releases/download/v2.50.0/gh_2.50.0_linux_amd64.tar.gz -o gh.tar.gz && \
    tar -xzf gh.tar.gz && \
    mv gh_2.50.0_linux_amd64/bin/gh /usr/local/bin/gh && \
    rm -rf gh.tar.gz gh_2.50.0_linux_amd64 && \
    dnf clean all

COPY .ants /workspace/.ants
COPY .ants/awaken.sh /usr/local/bin/awaken.sh
RUN chmod +x /usr/local/bin/awaken.sh

ENTRYPOINT ["awaken.sh"]