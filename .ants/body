FROM node:20-slim

WORKDIR /workspace

# 🧰 Install
RUN apt-get update && \
    apt-get install -y curl jq git && \
    curl -fsSL https://github.com/cli/cli/releases/download/v2.50.0/gh_2.50.0_linux_amd64.tar.gz -o gh.tar.gz && \
    tar -xzf gh.tar.gz && \
    mv gh_2.50.0_linux_amd64/bin/gh /usr/local/bin/gh && \
    rm -rf gh.tar.gz gh_2.50.0_linux_amd64 && \
    curl -fsSL https://opencode.ai/install | bash && \
    ln -sf /root/.opencode/bin/opencode /usr/local/bin/opencode && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

COPY .ants /workspace/.ants
ENTRYPOINT ["/workspace/.ants/awaken.sh"]